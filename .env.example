# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# ── Neo4j ────────────────────────────────────────────────────────────────────
# NEO4J_PASSWORD is consumed by docker-compose.yml (NEO4J_AUTH=neo4j/<password>)
# and by the Python driver via src/graphrag_mtg/config.py.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# ── Neo4j, MetaQA calibration instance (E-002 only) ──────────────────────────
# A second server, not a second database: Community serves exactly one user
# database. Started on demand and destroyed afterwards; it holds a public
# academic KB and no volume, which is why the password is a throwaway.
#   docker compose --profile metaqa up -d --wait
#   docker rm -f graphrag-mtg-neo4j-metaqa   # names the container, not the
#                                            # profile: --profile adds to the
#                                            # default set, it does not narrow
# Pointing this at NEO4J_URI is refused by graph/connection.py.
METAQA_NEO4J_URI=bolt://localhost:7688
METAQA_NEO4J_USER=neo4j
METAQA_NEO4J_PASSWORD=metaqa-throwaway

# ── LLM provider (Phases 3–5: extraction, text2cypher, generation) ───────────
# Default provider is Anthropic Claude (see docs/adr/adr-003-*).
# LLM_PROVIDER=openai switches to the Chat Completions API; pick a matching
# LLM_MODEL (e.g. gpt-4o-mini) or the client falls back to it automatically.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-opus-4-8

# ── Source downloads (Phase 1: etl/download.py) ──────────────────────────────
# Scryfall bulk is auto-resolved. These WotC docs are NOT auto-discoverable
# (the rules page is JS-rendered), so set the current URLs here. They change
# each release — find them via https://magic.wizards.com/en/rules and
# https://wpn.wizards.com/en/rules-documents. MTR/IPG are optional.
# CR_TXT_URL=https://media.wizards.com/2026/downloads/MagicCompRules%2020260227.txt
# MTR_PDF_URL=https://media.wizards.com/ContentResources/WPN/MTG_MTR_2026_Feb27_EN.pdf
# IPG_PDF_URL=

# ── Observability (Phase 7) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
