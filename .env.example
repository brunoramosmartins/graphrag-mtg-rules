# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# ── Neo4j ────────────────────────────────────────────────────────────────────
# NEO4J_PASSWORD is consumed by docker-compose.yml (NEO4J_AUTH=neo4j/<password>)
# and by the Python driver via src/graphrag_mtg/config.py.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# ── LLM provider (Phases 3–5: extraction, text2cypher, generation) ───────────
# Default provider is Anthropic Claude (see docs/adr/adr-003-*).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# ── Observability (Phase 7) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
